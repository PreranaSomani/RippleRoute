GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3001

ELEVENLABS_API_KEY=replace_with_your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=replace_with_your_elevenlabs_voice_id

DATABASE_URL=postgresql://username:password@your-service-host:5432/tsdb?sslmode=verify-full
# Optional absolute path to the service CA if it is not trusted by Node:
# DATABASE_CA_FILE=/absolute/path/to/service-ca.pem
